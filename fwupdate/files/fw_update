#!/bin/sh
set -u

. /usr/lib/fwupdate/common.sh

usage() {
    cat <<'USAGE'
usage: fw_update [options] FIRMWARE

Installs an already-downloaded postmerkOS switch image or SquashFS region.
Normal updates modify only SquashFS and the selected JFFS2 policy. The explicit
--full-flash mode overwrites bootloader, kernel, SquashFS, and JFFS2 from an
exact 16 MiB image.

Options:
  --checksum FILE       SHA-256 sidecar; must name FIRMWARE exactly
  --sha256 HASH         expected SHA-256 instead of a sidecar
  --overlay POLICY      preserve (default), migrate, reset, or image
  --version VERSION     version reported by the transport/catalog
  --source TEXT         source reported in status output
  --manifest FILE       release manifest for an unpadded SquashFS image
  --artifact-name NAME  original artifact basename when FIRMWARE is temporary
  --full-flash          overwrite all four NOR regions from a 16 MiB image
  --accept-full-flash   noninteractive acknowledgement for --full-flash
  --accept-untested     accept an untested but compatible switch model
  --yes                 do not ask for confirmation
  --force               override same/older/missing-metadata checks
  --verify-only         validate everything without changing flash
  --dry-run             prepare images/backups, but do not stop services
  --help

Overlay policies:
  preserve  Do not write JFFS2; retain it byte-for-byte.
  migrate   Build a clean JFFS2 image containing preserve.list paths.
  reset     Build and flash a completely clean JFFS2 overlay.
  image     Flash the 5 MiB JFFS2 region embedded in a 16 MiB full image.

Full-flash safety:
  --full-flash requires a complete 16 MiB image and always uses its embedded
  JFFS2 region. It is intended for recovery and deliberate bootloader/kernel
  replacement, including future experimental U-Boot images.
USAGE
}

CHECKSUM=""
EXPECTED_HASH=""
OVERLAY_POLICY=preserve
VERSION=""
SOURCE=local
ASSUME_YES=0
FORCE=0
VERIFY_ONLY=0
DRY_RUN=0
ACCEPT_UNTESTED=0
FULL_FLASH=0
ACCEPT_FULL_FLASH=0
MANIFEST=""
ARTIFACT_NAME=""
FIRMWARE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --checksum) [ "$#" -ge 2 ] || fw_die "--checksum requires a value"; CHECKSUM=$2; shift 2 ;;
        --sha256) [ "$#" -ge 2 ] || fw_die "--sha256 requires a value"; EXPECTED_HASH=$2; shift 2 ;;
        --overlay) [ "$#" -ge 2 ] || fw_die "--overlay requires a value"; OVERLAY_POLICY=$2; shift 2 ;;
        --version) [ "$#" -ge 2 ] || fw_die "--version requires a value"; VERSION=$2; shift 2 ;;
        --source) [ "$#" -ge 2 ] || fw_die "--source requires a value"; SOURCE=$2; shift 2 ;;
        --manifest) [ "$#" -ge 2 ] || fw_die "--manifest requires a value"; MANIFEST=$2; shift 2 ;;
        --artifact-name) [ "$#" -ge 2 ] || fw_die "--artifact-name requires a value"; ARTIFACT_NAME=$2; shift 2 ;;
        --full-flash) FULL_FLASH=1; shift ;;
        --accept-full-flash) ACCEPT_FULL_FLASH=1; shift ;;
        --accept-untested) ACCEPT_UNTESTED=1; shift ;;
        --yes) ASSUME_YES=1; shift ;;
        --force) FORCE=1; shift ;;
        --verify-only) VERIFY_ONLY=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --help|-h) usage; exit 0 ;;
        --) shift; break ;;
        -*) fw_die "unknown option: $1" ;;
        *)
            [ -z "$FIRMWARE" ] || fw_die "only one firmware file may be supplied"
            FIRMWARE=$1
            shift
            ;;
    esac
done
[ -n "$FIRMWARE" ] || { usage >&2; exit 2; }
[ -f "$FIRMWARE" ] || fw_die "firmware file not found: $FIRMWARE"
[ "$(id -u)" -eq 0 ] || fw_die "fw_update must run as root"
[ -n "$ARTIFACT_NAME" ] || ARTIFACT_NAME=$(basename "$FIRMWARE")
case "$ARTIFACT_NAME" in ''|*/*|*[!A-Za-z0-9._-]*) fw_die "invalid artifact basename: $ARTIFACT_NAME" ;; esac

case "$OVERLAY_POLICY" in
    preserve|migrate|reset|image) ;;
    *) fw_die "invalid overlay policy: $OVERLAY_POLICY" ;;
esac
if [ "$FULL_FLASH" -eq 1 ]; then
    OVERLAY_POLICY=image
    FWUPDATE_FLASH_SCOPE=full
else
    FWUPDATE_FLASH_SCOPE=system
fi
export FWUPDATE_FLASH_SCOPE

need_cmd awk
need_cmd dd
need_cmd hexdump
need_cmd sha256sum
need_cmd head
need_cmd fuser
need_cmd mountpoint
need_cmd umount
case "$OVERLAY_POLICY" in
    migrate|reset) need_cmd mkfs.jffs2 ;;
esac

FWUPDATE_SOURCE=$SOURCE
FWUPDATE_FIRMWARE=$ARTIFACT_NAME
export FWUPDATE_SOURCE FWUPDATE_FIRMWARE
check_work_base_ram
acquire_lock
trap 'release_lock' EXIT

status_write validating checksum 5 "Validating checksum"
if [ -n "$CHECKSUM" ] && [ -n "$EXPECTED_HASH" ]; then
    fw_die "use either --checksum or --sha256, not both"
elif [ -n "$CHECKSUM" ]; then
    verify_sidecar "$FIRMWARE" "$CHECKSUM"
elif [ -n "$EXPECTED_HASH" ]; then
    verify_expected_hash "$FIRMWARE" "$EXPECTED_HASH"
elif [ -f "$FIRMWARE.sha256" ]; then
    verify_sidecar "$FIRMWARE" "$FIRMWARE.sha256"
else
    fw_die "a matching SHA-256 sidecar or --sha256 value is required"
fi

status_write validating platform 10 "Checking board, release metadata, and MTD layout"
check_board
led_detect
if [ "$FULL_FLASH" -eq 1 ]; then
    check_full_mtd_layout
else
    check_mtd_layout
fi

FWUPDATE_CURRENT_VERSION=$(installed_version)
[ -n "$FWUPDATE_CURRENT_VERSION" ] || FWUPDATE_CURRENT_VERSION=unknown
if [ -n "$MANIFEST" ]; then
    [ -f "$MANIFEST" ] || fw_die "candidate manifest not found: $MANIFEST"
    "$FWUPDATE_MANIFEST_HELPER" validate "$MANIFEST" >/dev/null 2>&1 || \
        fw_die "candidate manifest is not valid postmerkOS release JSON"
    CANDIDATE_MANIFEST=$MANIFEST
    FWUPDATE_TARGET_VERSION=$(json_value version "$MANIFEST")
elif read_candidate_manifest "$FIRMWARE"; then
    :
elif [ -n "$VERSION" ]; then
    FWUPDATE_TARGET_VERSION=$VERSION
elif [ "$FORCE" -ne 1 ]; then
    fw_die "firmware release metadata is missing; use --force only for recovery/development images"
else
    FWUPDATE_TARGET_VERSION=unknown
fi
[ -n "$VERSION" ] && FWUPDATE_TARGET_VERSION=$VERSION

if [ -n "${CANDIDATE_MANIFEST:-}" ]; then
    manifest_hash=$(json_value artifact.sha256 "$CANDIDATE_MANIFEST" || true)
    if [ -n "$manifest_hash" ]; then
        manifest_hash=$(printf '%s' "$manifest_hash" | tr 'A-F' 'a-f')
        valid_sha256 "$manifest_hash" || fw_die "candidate manifest contains an invalid artifact SHA-256"
        [ "$manifest_hash" = "$FWUPDATE_SHA256" ] || \
            fw_die "candidate manifest SHA-256 does not match the validated firmware"
    fi
    manifest_bytes=$(json_value artifact.bytes "$CANDIDATE_MANIFEST" || true)
    if [ -n "$manifest_bytes" ]; then
        case "$manifest_bytes" in ''|*[!0-9]*) fw_die "candidate manifest contains an invalid artifact size" ;; esac
        [ "$manifest_bytes" -eq "$(file_size "$FIRMWARE")" ] || \
            fw_die "candidate manifest artifact size does not match the firmware"
    fi
    manifest_filename=$(json_value artifact.filename "$CANDIDATE_MANIFEST" || true)
    [ -z "$manifest_filename" ] || [ "$manifest_filename" = "$ARTIFACT_NAME" ] || \
        fw_die "candidate manifest filename does not match the firmware"
    candidate_compatibility=$(manifest_model_compatibility "$CANDIDATE_MANIFEST" "$FWUPDATE_MODEL" || true)
    [ -n "$candidate_compatibility" ] || \
        fw_die "candidate manifest does not list switch model $FWUPDATE_MODEL"
    case "$candidate_compatibility" in
        confirmed) FWUPDATE_COMPATIBILITY=validated ;;
        validated|untested)
            FWUPDATE_COMPATIBILITY=$candidate_compatibility ;;
        known-incompatible) fw_die "candidate manifest marks $FWUPDATE_MODEL incompatible" ;;
        *) fw_die "candidate manifest has an unknown compatibility state for $FWUPDATE_MODEL" ;;
    esac
fi
export FWUPDATE_CURRENT_VERSION FWUPDATE_TARGET_VERSION FWUPDATE_COMPATIBILITY

if [ "$FWUPDATE_TARGET_VERSION" = "$FWUPDATE_CURRENT_VERSION" ] && [ "$FORCE" -ne 1 ]; then
    fw_die "firmware version $FWUPDATE_TARGET_VERSION is already installed; use --force to reinstall"
fi
if [ "$FWUPDATE_TARGET_VERSION" != unknown ] && [ "$FWUPDATE_CURRENT_VERSION" != unknown ] && [ "$FORCE" -ne 1 ]; then
    comparison=$("$FWUPDATE_MANIFEST_HELPER" compare "$FWUPDATE_TARGET_VERSION" "$FWUPDATE_CURRENT_VERSION" 2>/dev/null || echo invalid)
    [ "$comparison" != invalid ] || fw_die "firmware versions could not be compared safely; use --force only after manual review"
    [ "$comparison" -ge 0 ] 2>/dev/null || \
        fw_die "firmware version $FWUPDATE_TARGET_VERSION is older than installed version $FWUPDATE_CURRENT_VERSION; use --force to downgrade"
fi
if [ "$FWUPDATE_COMPATIBILITY" != validated ] && [ "$ACCEPT_UNTESTED" -ne 1 ]; then
    if [ "$ASSUME_YES" -eq 1 ]; then
        fw_die "model/build state is $FWUPDATE_COMPATIBILITY; explicit --accept-untested acknowledgement is required"
    fi
    printf '\nWARNING: %s compatibility state for this candidate is %s.\n' \
        "$FWUPDATE_MODEL" "$FWUPDATE_COMPATIBILITY"
    printf 'Port mapping, PoE, LEDs, reset, management, and update behavior may not have been verified.\n'
    printf 'Type ACCEPT-UNTESTED to continue: '
    read -r untested_answer
    [ "$untested_answer" = ACCEPT-UNTESTED ] || fw_die "compatibility acknowledgement was declined"
    ACCEPT_UNTESTED=1
fi

if [ "$FULL_FLASH" -eq 1 ] && [ "$ACCEPT_FULL_FLASH" -ne 1 ]; then
    if [ "$ASSUME_YES" -eq 1 ]; then
        fw_die "--full-flash with --yes also requires --accept-full-flash"
    fi
    printf '\nDANGER: full flash will overwrite the bootloader, kernel, SquashFS, and JFFS2 regions.\n'
    printf 'A power loss or incompatible bootloader can require external SPI recovery.\n'
    printf 'Type FLASH-ALL to continue: '
    read -r full_flash_answer
    [ "$full_flash_answer" = FLASH-ALL ] || fw_die "full-flash acknowledgement was declined"
    ACCEPT_FULL_FLASH=1
fi

AVAILABLE_KB=$(df -Pk "$FWUPDATE_WORK_BASE" | awk 'NR == 2 {print $4}')
if [ "$FULL_FLASH" -eq 1 ]; then
    # Full-flash staging extracts loader, kernel, SquashFS, and JFFS2 while the
    # input image may still occupy the UART upload tmpfs. Require additional
    # headroom for UART recovery writes so low-memory failures happen before
    # any erase/write step.
    if [ "$SOURCE" = uart ]; then
        REQUIRED_KB=48000
    else
        REQUIRED_KB=40000
    fi
else
    case "$OVERLAY_POLICY" in
        preserve) REQUIRED_KB=20000 ;;
        *) REQUIRED_KB=32000 ;;
    esac
fi
[ -n "$AVAILABLE_KB" ] && [ "$AVAILABLE_KB" -ge "$REQUIRED_KB" ] || \
    fw_die "insufficient tmpfs space: need at least ${REQUIRED_KB} KiB free"

WORK="$FWUPDATE_WORK_BASE/fwupdate.$$"
mkdir -p "$WORK"
chmod 700 "$WORK"
cleanup_work() {
    rm -rf "$WORK" 2>/dev/null || true
    cleanup_transport_work
}
trap 'cleanup_work; release_lock' EXIT

IMAGE_SIZE=$(file_size "$FIRMWARE")
IMAGE_TYPE=""
LOADER_IMAGE=""
KERNEL_IMAGE=""
ROOT_IMAGE=""
OVERLAY_IMAGE=""

status_write validating image 15 "Validating firmware structure"
if [ "$IMAGE_SIZE" -eq "$FWUPDATE_FULL_IMAGE_SIZE" ]; then
    [ "$(read_magic "$FIRMWARE" "$FWUPDATE_ROOTFS_OFFSET" 4)" = "hsqs" ] || \
        fw_die "full images must contain a SquashFS filesystem at 0x300000"
    if [ "$FULL_FLASH" -ne 1 ]; then
        [ "$(read_magic "$FIRMWARE" "$FWUPDATE_KERNEL_OFFSET" 4)" = "SPIM" ] || \
            fw_die "normal updates require the current SPIM kernel layout; use --full-flash only for a reviewed alternate boot chain"
    fi
    IMAGE_TYPE=full
    if [ "$FULL_FLASH" -eq 1 ]; then
        LOADER_IMAGE="$WORK/loader.region"
        KERNEL_IMAGE="$WORK/kernel.region"
        dd if="$FIRMWARE" of="$LOADER_IMAGE" bs=65536 count=4 2>/dev/null || \
            fw_die "failed to extract bootloader region"
        dd if="$FIRMWARE" of="$KERNEL_IMAGE" bs=65536 skip=4 count=44 2>/dev/null || \
            fw_die "failed to extract kernel region"
        [ "$(file_size "$LOADER_IMAGE")" -eq "$FWUPDATE_LOADER_SIZE" ] || \
            fw_die "extracted bootloader region has the wrong size"
        [ "$(file_size "$KERNEL_IMAGE")" -eq "$FWUPDATE_KERNEL_SIZE" ] || \
            fw_die "extracted kernel region has the wrong size"
    fi
    ROOT_IMAGE="$WORK/rootfs.region"
    dd if="$FIRMWARE" of="$ROOT_IMAGE" bs=1M skip=3 count=8 2>/dev/null || \
        fw_die "failed to extract SquashFS region"
    [ "$(file_size "$ROOT_IMAGE")" -eq "$FWUPDATE_ROOTFS_SIZE" ] || \
        fw_die "extracted SquashFS region has the wrong size"
else
    [ "$FULL_FLASH" -ne 1 ] || fw_die "--full-flash requires an exact 16 MiB image"
    [ "$(read_magic "$FIRMWARE" 0 4)" = "hsqs" ] || \
        fw_die "input is neither a valid full postmerkOS image nor a SquashFS"
    [ "$IMAGE_SIZE" -gt 0 ] && [ "$IMAGE_SIZE" -le "$FWUPDATE_ROOTFS_SIZE" ] || \
        fw_die "SquashFS exceeds the 8 MiB partition"
    IMAGE_TYPE=squashfs
    ROOT_IMAGE="$WORK/rootfs.squashfs"
    cp "$FIRMWARE" "$ROOT_IMAGE" || fw_die "failed to stage SquashFS in tmpfs"
fi

ROOT_IMAGE_SIZE=$(file_size "$ROOT_IMAGE")
CANDIDATE_ROOT_HASH=$(sha256sum "$ROOT_IMAGE" | awk '{print $1}')
CURRENT_ROOT_HASH=$(head -c "$ROOT_IMAGE_SIZE" "/dev/$ROOT_MTD" 2>/dev/null | sha256sum | awk '{print $1}')
if [ "$FULL_FLASH" -ne 1 ] && [ "$CANDIDATE_ROOT_HASH" = "$CURRENT_ROOT_HASH" ] && [ "$FORCE" -ne 1 ]; then
    fw_die "the SquashFS content already matches the installed firmware; use --force to reinstall"
fi

make_overlay_tree() {
    tree=$1
    mkdir -p "$tree/.upper/etc" "$tree/.work/etc" \
             "$tree/.upper/root" "$tree/.work/root"
}

build_overlay_image() {
    root=$1
    out=$2
    mkfs.jffs2 --pad="$FWUPDATE_OVERLAY_SIZE" -l -n \
        -X lzo -x zlib -y 40:lzo -r "$root" -o "$out" >/dev/null || \
        fw_die "failed to generate JFFS2 image"
    [ "$(file_size "$out")" -eq "$FWUPDATE_OVERLAY_SIZE" ] || \
        fw_die "generated JFFS2 image has the wrong size"
    [ "$(read_hex "$out" 0 2)" = "8519" ] || \
        fw_die "generated JFFS2 image has an invalid magic value"
}

case "$OVERLAY_POLICY" in
    preserve)
        ;;
    image)
        [ "$IMAGE_TYPE" = full ] || fw_die "--overlay image requires a 16 MiB full image"
        OVERLAY_IMAGE="$WORK/overlay.region"
        dd if="$FIRMWARE" of="$OVERLAY_IMAGE" bs=1M skip=11 count=5 2>/dev/null || \
            fw_die "failed to extract JFFS2 region"
        [ "$(file_size "$OVERLAY_IMAGE")" -eq "$FWUPDATE_OVERLAY_SIZE" ] || \
            fw_die "extracted JFFS2 region has the wrong size"
        [ "$(read_hex "$OVERLAY_IMAGE" 0 2)" = "8519" ] || \
            fw_die "embedded JFFS2 region has an invalid magic value"
        ;;
    reset)
        make_overlay_tree "$WORK/overlay-root"
        OVERLAY_IMAGE="$WORK/overlay.region"
        build_overlay_image "$WORK/overlay-root" "$OVERLAY_IMAGE"
        ;;
    migrate)
        make_overlay_tree "$WORK/overlay-root"
        [ -f "$FWUPDATE_PRESERVE_FILE" ] || fw_die "preserve list not found: $FWUPDATE_PRESERVE_FILE"
        while IFS= read -r src || [ -n "$src" ]; do
            case "$src" in ""|\#*) continue ;; esac
            case "$src" in
                /etc/*|/root/*) ;;
                *) fw_die "invalid preserve path: $src" ;;
            esac
            [ -e "$src" ] || [ -L "$src" ] || continue
            case "$src" in
                /etc/*) dest="$WORK/overlay-root/.upper/etc/${src#/etc/}" ;;
                /root/*) dest="$WORK/overlay-root/.upper/root/${src#/root/}" ;;
            esac
            mkdir -p "$(dirname "$dest")"
            cp -a "$src" "$dest" || fw_die "failed to preserve $src"
        done < "$FWUPDATE_PRESERVE_FILE"
        OVERLAY_IMAGE="$WORK/overlay.region"
        build_overlay_image "$WORK/overlay-root" "$OVERLAY_IMAGE"
        ;;
esac

# Release transport staging resources before region preparation.
cleanup_transport_work
if [ "$VERIFY_ONLY" -ne 1 ]; then
    case "$FIRMWARE" in
        /run/fwupdate/uploads/*|/tmp/postmerkos-upload-*) rm -f "$FIRMWARE" 2>/dev/null || true ;;
    esac
fi

LOADER_BACKUP=""
KERNEL_BACKUP=""
ROOT_BACKUP="$WORK/rootfs.backup"
OVERLAY_BACKUP=""
if [ "$FULL_FLASH" -eq 1 ]; then
    LOADER_BACKUP="$WORK/loader.backup"
    KERNEL_BACKUP="$WORK/kernel.backup"
fi
[ -n "$OVERLAY_IMAGE" ] && OVERLAY_BACKUP="$WORK/overlay.backup"

FLASH_HELPER=/usr/libexec/fwupdate/fwflash
[ -x "$FLASH_HELPER" ] || fw_die "RAM flashing helper is missing: $FLASH_HELPER"
cp "$FLASH_HELPER" "$WORK/fwflash" || fw_die "failed to copy flashing helper to tmpfs"
chmod 700 "$WORK/fwflash"

status_write ready confirm 30 "Firmware is validated and ready to install"
printf '\nFirmware: %s\n' "$FIRMWARE"
printf 'SHA-256: %s\n' "$FWUPDATE_SHA256"
printf 'Input type: %s\n' "$IMAGE_TYPE"
printf 'Flash scope: %s\n' "$FWUPDATE_FLASH_SCOPE"
printf 'Overlay policy: %s\n' "$OVERLAY_POLICY"
printf 'Current version: %s\n' "${FWUPDATE_CURRENT_VERSION:-unknown}"
printf 'New version: %s\n' "${FWUPDATE_TARGET_VERSION:-unknown}"
printf '\nThe switch will stop network services and reboot after flashing.\n'
if [ "$FULL_FLASH" -eq 1 ]; then
    printf 'The bootloader and kernel will also be erased and rewritten. External SPI recovery may be required.\n\n'
else
    printf 'Loss of power while the SquashFS partition is being written can require hardware recovery.\n\n'
fi

if [ "$VERIFY_ONLY" -eq 1 ]; then
    status_write success verified 100 "Firmware and flash layout validation succeeded"
    exit 0
fi
if [ "$DRY_RUN" -eq 1 ]; then
    status_write success dry_run 100 "Dry run completed; no services stopped and no flash written"
    exit 0
fi
if [ "$ASSUME_YES" -ne 1 ]; then
    printf 'Type UPGRADE to continue: '
    read -r answer
    [ "$answer" = UPGRADE ] || fw_die "upgrade cancelled"
fi

history_prepare
LED_HANDLER=
LED_PORTS=0
STATUS_LED_PATH=
STATUS_LED_GREEN_PATH=
STATUS_LED_ORANGE_PATH=
STATUS_LED_PROTOCOL=
STATUS_LED_ACTIVE=1
if command -v postmerkos-ledctl >/dev/null 2>&1; then
    command -v postmerkos-hwprobe >/dev/null 2>&1 && postmerkos-hwprobe refresh >/dev/null 2>&1 || true
    LED_ACQUIRED=0
    postmerkos-ledctl acquire firmware >/dev/null 2>&1 && LED_ACQUIRED=1 || true
    if [ "$LED_ACQUIRED" = 1 ] && [ -r /run/postmerkos/led-capabilities.env ]; then
        . /run/postmerkos/led-capabilities.env
    fi
    if [ "${LED_ACQUIRED:-0}" = 1 ] && [ "${PORT_LED_AVAILABLE:-0}" = 1 ] && [ "${PORT_LED_VERIFIED:-0}" = 1 ]; then
        LED_HANDLER=${PORT_LED_HANDLER:-/click/sw0_ctrl/poe_led_state}
        LED_PORTS=$(postmerkosctl status 2>/dev/null | sed -n 's/.*"copper_ports"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' | sed -n '1p')
    elif [ "${STATUS_LED_AVAILABLE:-0}" = 1 ] && [ "${STATUS_LED_VERIFIED:-0}" = 1 ]; then
        STATUS_LED_GREEN_PATH=${STATUS_LED_GREEN_PATH:-}
        STATUS_LED_ORANGE_PATH=${STATUS_LED_ORANGE_PATH:-}
        STATUS_LED_PROTOCOL=${STATUS_LED_PROTOCOL:-named-state}
        STATUS_LED_PATH=${STATUS_LED_GREEN_PATH:-${STATUS_LED_PATH:-}}
        STATUS_LED_ACTIVE=${STATUS_LED_ACTIVE:-1}
    fi
fi
status_write starting acknowledged 34 "Starting firmware update; management services will stop shortly"
status_write preparing quiesce 35 "Stopping services and unmounting the writable overlay"
trap '' HUP
cd /tmp || fw_die "cannot change directory to /tmp"
sync

# Stop processes that may hold files in /etc, /root, or the SquashFS lower layer.
for proc in configd uhttpd chronyd chrony syslogd klogd crond ntpd dhcpclient; do
    killall "$proc" >/dev/null 2>&1 || true
done
# Stop SSH last. The updater ignores SIGHUP and continues from tmpfs.
killall dropbear >/dev/null 2>&1 || true
sleep 2

# Quiesce any remaining userspace process, including background board scripts
# that are not known by a stable process name. PID 1 is left alone; this shell
# is about to exec the static helper from tmpfs.
quiesce_remaining_userspace() {
    signal=$1
    for procdir in /proc/[0-9]*; do
        pid=${procdir#/proc/}
        case "$pid" in 1|$$) continue ;; esac
        kill "-$signal" "$pid" >/dev/null 2>&1 || true
    done
}
quiesce_remaining_userspace TERM
sleep 1
quiesce_remaining_userspace KILL

unmount_one() {
    target=$1
    if mountpoint -q "$target" 2>/dev/null; then
        umount "$target" >/dev/null 2>&1 || {
            fuser -km "$target" >/dev/null 2>&1 || true
            sleep 1
            umount "$target" >/dev/null 2>&1 || return 1
        }
    fi
    return 0
}

# Unmount both overlays even when JFFS2 is preserved. This removes references
# to the SquashFS lower layer before the rootfs partition is erased.
if ! unmount_one /root || ! unmount_one /etc || ! unmount_one /overlay; then
    status_write error unmount 100 "Could not unmount overlay filesystems; rebooting without flashing"
    sync
    sleep 2
    reboot -f >/dev/null 2>&1 || echo b > /proc/sysrq-trigger
    exit 1
fi

# Take rollback snapshots only after writers are stopped and JFFS2 is
# unmounted, so a failed transaction restores a consistent overlay image.
status_write preparing backup 38 "Backing up current flash partitions for rollback"
if [ "$FULL_FLASH" -eq 1 ]; then
    if ! dd if="/dev/$LOADER_MTD" of="$LOADER_BACKUP" bs=65536 count=4 2>/dev/null || \
       [ "$(file_size "$LOADER_BACKUP" 2>/dev/null || echo 0)" -ne "$FWUPDATE_LOADER_SIZE" ]; then
        status_write error backup 100 "Could not back up bootloader; rebooting without flashing"
        sync; sleep 2; reboot -f >/dev/null 2>&1 || echo b > /proc/sysrq-trigger
        exit 1
    fi
    if ! dd if="/dev/$KERNEL_MTD" of="$KERNEL_BACKUP" bs=65536 count=44 2>/dev/null || \
       [ "$(file_size "$KERNEL_BACKUP" 2>/dev/null || echo 0)" -ne "$FWUPDATE_KERNEL_SIZE" ]; then
        status_write error backup 100 "Could not back up kernel; rebooting without flashing"
        sync; sleep 2; reboot -f >/dev/null 2>&1 || echo b > /proc/sysrq-trigger
        exit 1
    fi
fi
if ! dd if="/dev/$ROOT_MTD" of="$ROOT_BACKUP" bs=1M count=8 2>/dev/null || \
   [ "$(file_size "$ROOT_BACKUP" 2>/dev/null || echo 0)" -ne "$FWUPDATE_ROOTFS_SIZE" ]; then
    status_write error backup 100 "Could not back up SquashFS; rebooting without flashing"
    sync
    sleep 2
    reboot -f >/dev/null 2>&1 || echo b > /proc/sysrq-trigger
    exit 1
fi
if [ -n "$OVERLAY_IMAGE" ]; then
    if ! dd if="/dev/$OVERLAY_MTD" of="$OVERLAY_BACKUP" bs=1M count=5 2>/dev/null || \
       [ "$(file_size "$OVERLAY_BACKUP" 2>/dev/null || echo 0)" -ne "$FWUPDATE_OVERLAY_SIZE" ]; then
        status_write error backup 100 "Could not back up JFFS2; rebooting without flashing"
        sync
        sleep 2
        reboot -f >/dev/null 2>&1 || echo b > /proc/sysrq-trigger
        exit 1
    fi
fi
sync

status_write flashing handoff 40 "Handing control to the RAM-resident flashing helper"
trap - EXIT

set -- "$WORK/fwflash" \
    --rootfs-image "$ROOT_IMAGE" \
    --rootfs-mtd "/dev/$ROOT_MTD" \
    --rootfs-backup "$ROOT_BACKUP" \
    --status-file "$FWUPDATE_STATUS_FILE" \
    --log-file /run/fwupdate/flash.log \
    --source "$SOURCE" \
    --firmware "$FWUPDATE_FIRMWARE" \
    --target-version "${FWUPDATE_TARGET_VERSION:-unknown}"
if [ "$FULL_FLASH" -eq 1 ]; then
    set -- "$@" \
        --loader-image "$LOADER_IMAGE" \
        --loader-mtd "/dev/$LOADER_MTD" \
        --loader-backup "$LOADER_BACKUP" \
        --kernel-image "$KERNEL_IMAGE" \
        --kernel-mtd "/dev/$KERNEL_MTD" \
        --kernel-backup "$KERNEL_BACKUP"
fi
if [ -n "$LED_HANDLER" ] && [ "${LED_PORTS:-0}" -gt 0 ] 2>/dev/null; then
    set -- "$@" --led-handler "$LED_HANDLER" --led-ports "$LED_PORTS"
elif [ -n "$STATUS_LED_GREEN_PATH" ] && [ -n "$STATUS_LED_ORANGE_PATH" ]; then
    set -- "$@" --status-led-backend click-dual-state \
        --status-led-green "$STATUS_LED_GREEN_PATH" \
        --status-led-orange "$STATUS_LED_ORANGE_PATH"
elif [ -n "$STATUS_LED_PATH" ]; then
    set -- "$@" --status-led "$STATUS_LED_PATH" --status-led-active "$STATUS_LED_ACTIVE"
fi
if [ -n "$OVERLAY_IMAGE" ]; then
    set -- "$@" \
        --overlay-image "$OVERLAY_IMAGE" \
        --overlay-mtd "/dev/$OVERLAY_MTD" \
        --overlay-backup "$OVERLAY_BACKUP"
fi
exec "$@"
