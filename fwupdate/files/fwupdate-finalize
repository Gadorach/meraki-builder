#!/bin/sh
set -eu
history=/config/postmerkos/update-history
pending="$history/pending.json"
[ -f "$pending" ] || exit 0
mkdir -p "$history"
helper=/usr/libexec/fwupdate/fwmanifest
[ -x "$helper" ] || exit 1
installed=$($helper get /etc/postmerkos-release.json version 2>/dev/null || true)
target=$($helper get "$pending" target_version 2>/dev/null || true)
started=$($helper get "$pending" started 2>/dev/null || true)
flash_scope=$($helper get "$pending" flash_scope 2>/dev/null || true)
case "$flash_scope" in system|full) ;; *) flash_scope=system ;; esac
result=interrupted
message='Firmware update did not reach the requested release'
[ -n "$target" ] && [ "$installed" = "$target" ] && { result=success; message='Firmware update completed and the target release booted'; }
cat > "$history/last.json.tmp" <<EOF_LAST
{"result":"$result","started":${started:-0},"completed":$(date +%s 2>/dev/null || echo 0),"target_version":"${target:-unknown}","installed_version":"${installed:-unknown}","flash_scope":"$flash_scope","message":"$message"}
EOF_LAST
mv -f "$history/last.json.tmp" "$history/last.json"
[ -f /run/fwupdate/live.log ] && cp -f /run/fwupdate/live.log "$history/last.log" || true
rm -f "$pending"
exit 0
