compatibility_first_access() {
    local state
    [ "$("$CTL" compatibility-needed 2>/dev/null || echo no)" = yes ] || return 0
    state=$(cfg_get_device_compatibility 2>/dev/null || echo untested)
    while :; do
        if [ "$state" = known-incompatible ]; then
            heading 'Known-Incompatible Firmware'
            cat <<'EOF_COMPAT_BAD'
This firmware release is explicitly marked known-incompatible with the detected
switch model. This notice cannot be dismissed. Do not flash another image from
this release or rely on port, PoE, LED, reset, or updater hardware behavior.

1) Display diagnostic compatibility report
2) Display issue-report information
4) Return to the menu
EOF_COMPAT_BAD
        else
            heading 'Untested Switch Model'
            cat <<'EOF_COMPAT'
This switch model is currently marked as untested.

postmerkOS has booted successfully, but port mapping, PoE, LED control, and
firmware update behavior may not have been confirmed on this exact model.
Please consider opening an issue in the project repository with a compatibility
report and any errors you observe.

1) Display diagnostic compatibility report
2) Display issue-report information
3) Dismiss for this firmware version
4) Remind me next time
EOF_COMPAT
        fi
        read_choice 'compatibility> '
        case "$CHOICE" in
            1) heading 'Compatibility Report'; "$CTL" compatibility-report; pause ;;
            2) heading 'Compatibility Reporting'; echo 'Project issues: https://github.com/Gadorach/meraki-builder/issues'; echo; echo 'Include the diagnostic report, model, port/PoE behavior, and any boot or update errors.'; pause ;;
            3) if [ "$state" = known-incompatible ]; then echo 'Known-incompatible releases cannot be acknowledged.'; pause; else "$CTL" compatibility-ack; pause; return; fi ;;
            4|b|B|0|'') return ;;
            *) echo 'Unknown option.'; sleep 1 ;;
        esac
    done
}

main_menu() {
    suppress_console_chatter
    default_password_warning
    compatibility_first_access
    while :; do
        heading ''
        echo '- type the preferred option to continue'
        echo
        menu5= menu6= menu7= menu8= menu3= menu4=
        can users.manage && menu5='5) User Management'
        can services.manage && menu6='6) Service Management'
        can system.reboot && menu7='7) Power Control'
        can terminal.exec && menu8='8) Shell'
        can firmware.update && menu3='3) Firmware Update'
        can backup.create && menu4='4) Backup & Restore'
        printf '%-34s %s\n' '1) Status' "$menu5"
        printf '%-34s %s\n' '2) Port Configuration' "$menu6"
        printf '%-34s %s\n' "$menu3" "$menu7"
        printf '%-34s %s\n' "$menu4" "$menu8"
        echo '0) Log out'
        read_choice 'postmerkOS> '
        case "$CHOICE" in
            1) system_status_menu ;;
            2) port_configuration_menu ;;
            3) if can firmware.update; then firmware_menu; else echo 'Permission denied.'; pause; fi ;;
            4) if can backup.create; then backup_restore_menu; else echo 'Permission denied.'; pause; fi ;;
            5) if can users.manage; then user_management_menu; else echo 'Permission denied.'; pause; fi ;;
            6) if can services.manage; then service_management_menu; else echo 'Permission denied.'; pause; fi ;;
            7) if can system.reboot; then power_control_menu; else echo 'Permission denied.'; pause; fi ;;
            8|s|S|shell)
                if can terminal.exec; then
                    restore_console_chatter
                    clear_screen
                    echo 'Entering the raw Linux shell. Run "pmc" to return to the postmerkOS console.'
                    POSTMERKOS_RAW_SHELL=1 /bin/sh -l
                    suppress_console_chatter
                else
                    echo 'Permission denied.'; pause
                fi
                ;;
            0|q|Q|logout|exit|'') restore_console_chatter; return 0 ;;
            help|'?') usage; pause ;;
            *) echo 'Unknown option.'; sleep 1 ;;
        esac
    done
}

main() {
    local command sub port path wait_attempts
    command=${1:-menu}
    wait_attempts=1
    [ "$command" = menu ] && wait_attempts=${POSTMERKOS_SESSION_WAIT:-30}
    refresh_session "$wait_attempts" || true
    if [ "$SESSION_STATE" != ok ]; then
        if [ "$SESSION_STATE" = role-none ]; then
            echo 'This account has no postmerkOS management role.' >&2
        else
            echo 'The postmerkOS management service is unavailable.' >&2
            [ -n "$SESSION_ERROR" ] && printf 'Reason: %s\n' "$SESSION_ERROR" >&2
            echo 'Use "postmerkosctl management-health" or the serial console status/logs commands for diagnostics.' >&2
        fi
        return 1
    fi
    detect_layout
    case "$command" in
        menu) main_menu ;;
        status) "$CTL" summary ;;
        ports) "$CTL" ports "1-$TOTAL_PORTS" ;;
        port)
            sub=${2:-}
            case "$sub" in
                show) [ "$#" -eq 3 ] && "$CTL" port "$3" || { usage >&2; return 2; } ;;
                set)
                    [ "$#" -ge 5 ] || { usage >&2; return 2; }
                    port=$3; path=$4; shift 4
                    "$CTL" set "ports.$port.$path" "$*"
                    ;;
                *) [ "$#" -eq 2 ] && "$CTL" port "$2" || { usage >&2; return 2; } ;;
            esac
            ;;
        set)
            [ "$#" -ge 3 ] || { usage >&2; return 2; }
            path=$2; shift 2
            "$CTL" set "$path" "$*"
            ;;
        set-string)
            [ "$#" -ge 3 ] || { usage >&2; return 2; }
            path=$2; shift 2
            "$CTL" set-string "$path" "$*"
            ;;
        config)
            sub=${2:-}
            case "$sub" in
                show) "$CTL" config ;;
                backup)
                    can backup.create || { echo 'Permission denied.' >&2; return 1; }
                    [ "$#" -eq 3 ] && "$CTL" backup "$3" || { usage >&2; return 2; }
                    ;;
                restore)
                    can config.restore || { echo 'Permission denied.' >&2; return 1; }
                    [ "$#" -eq 3 ] || { usage >&2; return 2; }
                    "$CTL" restore "$3"
                    ;;
                *) usage >&2; return 2 ;;
            esac
            ;;
        firmware)
            sub=${2:-status}; shift 2 2>/dev/null || shift 1
            case "$sub" in
                status) fw_update_status "$@" ;;
                local|tftp|http|sftp|uart)
                    can firmware.update || { echo 'Permission denied.' >&2; return 1; }
                    case "$sub" in
                        local) exec fw_update "$@" ;;
                        tftp) exec fw_update_tftp "$@" ;;
                        http) exec fw_update_http "$@" ;;
                        sftp) exec fw_update_sftp "$@" ;;
                        uart) exec fw_update_uart "$@" ;;
                    esac
                    ;;
                *) usage >&2; return 2 ;;
            esac
            ;;
        password) passwd "${2:-root}" ;;
        shell)
            can terminal.exec || { echo 'Permission denied.' >&2; return 1; }
            POSTMERKOS_RAW_SHELL=1 exec /bin/sh -l
            ;;
        help|-h|--help) usage ;;
        *) usage >&2; return 2 ;;
    esac
}

main "$@"
