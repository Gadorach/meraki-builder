display_configuration_copy() {
    local temp=/run/postmerkos/config-copy.$$.json hash
    mkdir -p /run/postmerkos
    "$CTL" backup "$temp" || { echo 'Unable to export configuration.'; return 1; }
    hash=$(sha256sum "$temp" | awk '{print $1}')
    restore_console_chatter
    printf '\n----- BEGIN POSTMERKOS CONFIGURATION -----\n'
    cat "$temp"
    printf '%s\n' '----- END POSTMERKOS CONFIGURATION -----'
    printf 'SHA-256: %s\n' "$hash"
    rm -f "$temp"
    suppress_console_chatter
}

backup_to_tftp() {
    local server remote port temp
    printf 'TFTP server: '; read -r server
    [ -n "$server" ] || { echo 'TFTP server is required.'; return 1; }
    remote="postmerkos-${MODEL:-switch}-$(date +%Y%m%d-%H%M%S).json"
    printf 'Remote filename [%s]: ' "$remote"; read -r answer; remote=${answer:-$remote}
    printf 'TFTP port [69]: '; read -r port; port=${port:-69}
    temp=/run/postmerkos/preupdate-config.$$.json
    mkdir -p /run/postmerkos
    "$CTL" backup "$temp" || return 1
    if command -v curl >/dev/null 2>&1; then
        curl --fail --silent --show-error --upload-file "$temp" "tftp://$server:$port/${remote#/}"
    else
        tftp -p -l "$temp" -r "$remote" "$server" "$port"
    fi
    rc=$?
    rm -f "$temp"
    [ "$rc" -eq 0 ] && { echo "Configuration uploaded as $remote"; return 0; }
    echo 'TFTP backup failed.'
    return 1
}

preupdate_backup_prompt() {
    while :; do
        heading 'Pre-update configuration backup'
        cat <<'EOF_PREBACKUP'
1) Upload configuration backup to a TFTP server
2) Display configuration for manual copying
3) Continue without a backup
4) Cancel firmware update
EOF_PREBACKUP
        read_choice 'backup> '
        case "$CHOICE" in
            1) backup_to_tftp && return 0; pause ;;
            2) display_configuration_copy; printf '\nPress Enter after copying, or enter c to cancel the update: '; read -r answer; [ "$answer" = c ] && return 1; return 0 ;;
            3) confirm_word CONTINUE 'Type CONTINUE to proceed without an external backup: ' && return 0 ;;
            4|b|B|0|'') return 1 ;;
            *) echo 'Unknown option.'; sleep 1 ;;
        esac
    done
}

select_overlay() {
    echo 'Overlay policy:' >&2
    echo '  1) preserve - keep settings byte-for-byte' >&2
    echo '  2) migrate  - copy selected settings into a clean overlay' >&2
    echo '  3) reset    - erase settings' >&2
    echo '  4) image    - use overlay embedded in a full firmware image' >&2
    printf 'Selection [1]: ' >&2
    read -r selection
    case "${selection:-1}" in
        1) echo preserve ;; 2) echo migrate ;; 3) echo reset ;; 4) echo image ;; *) echo preserve ;;
    esac
}

select_flash_scope() {
    echo 'Flash scope:' >&2
    echo '  1) system - update SquashFS and the selected JFFS2 policy' >&2
    echo '  2) full   - overwrite loader, kernel, SquashFS, and JFFS2' >&2
    printf 'Selection [1]: ' >&2
    read -r selection
    case "${selection:-1}" in
        2) echo full ;;
        *) echo system ;;
    esac
}

select_force_mode() {
    echo 'Force mode:' >&2
    echo '  1) normal - require compatible/new metadata and avoid same-version reinstall' >&2
    echo '  2) force  - allow reinstall/downgrade/development metadata exceptions; SHA-256 still required' >&2
    printf 'Selection [1]: ' >&2
    read -r selection
    case "${selection:-1}" in
        2) echo --force ;;
        *) echo ;;
    esac
}

select_artifact_contract() {
    echo 'Artifact validation:' >&2
    echo '  1) manifest - firmware, checksum, manifest, and manifest checksum' >&2
    echo '  2) checksum - original firmware and checksum files only' >&2
    printf 'Selection [1]: ' >&2
    read -r selection
    case "${selection:-1}" in
        2) echo checksum ;;
        *) echo manifest ;;
    esac
}

firmware_menu() {
    local file hash overlay server remote port url user password accept_arg force_arg scope contract scope_args contract_args
    while :; do
        heading 'Firmware Update'
        cat <<'EOF_FW'
1) Firmware update history
2) Install a local firmware image
3) Download and install by TFTP
4) Download and install by HTTP/HTTPS
5) Download and install by SFTP
6) Receive and install an image over UART
7) Verify a local image without flashing
b) Back
EOF_FW
        read_choice 'firmware> '
        case "$CHOICE" in
            1) heading 'Firmware update history'; cat /config/postmerkos/update-history/last.json 2>/dev/null || echo 'No completed update record exists.'; echo; cat /config/postmerkos/update-history/last.log 2>/dev/null || true; pause ;;
            2|7)
                heading 'Local firmware image'
                printf 'Firmware path: '; read -r file
                [ -f "$file" ] || { echo 'File not found.'; pause; continue; }
                hash=$(sha256sum "$file" | awk '{print $1}') || { echo 'Unable to hash firmware.'; pause; continue; }
                scope=$(select_flash_scope)
                scope_args=
                if [ "$scope" = full ]; then
                    overlay=image
                    scope_args=--full-flash
                else
                    overlay=$(select_overlay)
                fi
                accept_arg=
                [ "$(cfg_get_device_compatibility 2>/dev/null || echo confirmed)" = untested ] && accept_arg=--accept-untested
                force_arg=$(select_force_mode)
                if [ "$CHOICE" = 7 ]; then
                    fw_update --sha256 "$hash" --overlay "$overlay" $scope_args $accept_arg $force_arg --verify-only "$file"
                else
                    preupdate_backup_prompt || { echo 'Firmware update cancelled.'; pause; continue; }
                    fw_update --sha256 "$hash" --overlay "$overlay" $scope_args $accept_arg $force_arg "$file"
                fi
                pause ;;
            3)
                heading 'TFTP firmware update'
                preupdate_backup_prompt || { echo 'Firmware update cancelled.'; pause; continue; }
                printf 'TFTP server: '; read -r server
                printf 'Remote firmware path: '; read -r remote
                printf 'TFTP port [69]: '; read -r port; port=${port:-69}
                contract=$(select_artifact_contract)
                [ "$contract" = checksum ] && contract_args=--no-manifest || contract_args=
                scope=$(select_flash_scope)
                if [ "$scope" = full ]; then overlay=image; scope_args=--full-flash; else overlay=$(select_overlay); scope_args=; fi
                force_arg=$(select_force_mode)
                fw_update_tftp --server "$server" --file "$remote" --port "$port" --overlay "$overlay" $contract_args $scope_args $force_arg
                pause ;;
            4)
                heading 'HTTP/HTTPS firmware update'
                command -v fw_update_http >/dev/null 2>&1 || { echo 'HTTP updater support is not installed.'; pause; continue; }
                preupdate_backup_prompt || { echo 'Firmware update cancelled.'; pause; continue; }
                printf 'Direct firmware URL (blank opens configured catalog): '; read -r url
                contract=$(select_artifact_contract)
                [ "$contract" = checksum ] && contract_args=--no-manifest || contract_args=
                scope=$(select_flash_scope)
                if [ "$scope" = full ]; then overlay=image; scope_args=--full-flash; else overlay=$(select_overlay); scope_args=; fi
                force_arg=$(select_force_mode)
                if [ -n "$url" ]; then fw_update_http --url "$url" --overlay "$overlay" $contract_args $scope_args $force_arg; else fw_update_http --overlay "$overlay" $contract_args $scope_args $force_arg; fi
                pause ;;
            5)
                heading 'SFTP firmware update'
                command -v fw_update_sftp >/dev/null 2>&1 || { echo 'SFTP updater support is not installed.'; pause; continue; }
                preupdate_backup_prompt || { echo 'Firmware update cancelled.'; pause; continue; }
                printf 'SFTP server: '; read -r server
                printf 'Remote firmware path: '; read -r remote
                printf 'Username: '; read -r user
                password=$(read_secret 'Password: ')
                contract=$(select_artifact_contract)
                [ "$contract" = checksum ] && contract_args=--no-manifest || contract_args=
                scope=$(select_flash_scope)
                if [ "$scope" = full ]; then overlay=image; scope_args=--full-flash; else overlay=$(select_overlay); scope_args=; fi
                force_arg=$(select_force_mode)
                fw_update_sftp --server "$server" --file "$remote" --user "$user" --password "$password" --overlay "$overlay" $contract_args $scope_args $force_arg
                pause ;;
            6)
                heading 'UART firmware upload'
                preupdate_backup_prompt || { echo 'Firmware update cancelled.'; pause; continue; }
                scope=$(select_flash_scope)
                if [ "$scope" = full ]; then overlay=image; scope_args=--full-flash; else overlay=$(select_overlay); scope_args=; fi
                echo 'Waiting for the host flasher to send PMOSUART/1 framed data.'
                echo 'Do not type into this console until the transfer finishes.'
                force_arg=$(select_force_mode)
                fw_update_uart --overlay "$overlay" $scope_args $force_arg
                pause ;;
            b|B|0|'') return ;;
            *) echo 'Unknown option.'; sleep 1 ;;
        esac
    done
}

cfg_get_device_compatibility() {
    "$CTL" status 2>/dev/null | sed -n 's/.*"compatibility"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

restore_from_tftp() {
    local server remote port temp
    can config.restore || { echo 'Permission denied.'; return 1; }
    printf 'TFTP server: '; read -r server
    printf 'Remote filename: '; read -r remote
    printf 'TFTP port [69]: '; read -r port; port=${port:-69}
    temp=/run/postmerkos/restore.$$.json
    mkdir -p /run/postmerkos
    if command -v curl >/dev/null 2>&1; then
        curl --fail --silent --show-error --output "$temp" "tftp://$server:$port/${remote#/}" || { rm -f "$temp"; return 1; }
    else
        tftp -g -l "$temp" -r "$remote" "$server" "$port" || { rm -f "$temp"; return 1; }
    fi
    "$CTL" validate "$temp" || { rm -f "$temp"; return 1; }
    if confirm_word RESTORE 'Type RESTORE to apply the downloaded configuration: '; then "$CTL" restore "$temp"; fi
    rm -f "$temp"
}

