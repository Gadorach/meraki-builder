            "$("$CTL" service-get "$service.enabled" 2>/dev/null || echo unknown)" \
            "$("$CTL" service-get "$service.autostart" 2>/dev/null || echo unknown)"
        cat <<'EOF_SVC'
1) Start
2) Stop
3) Restart
4) Toggle enabled policy
5) Toggle automatic startup
b) Back
EOF_SVC
        read_choice 'service> '
        case "$CHOICE" in
            1) action=start ;;
            2) action=stop ;;
            3) action=restart ;;
            4)
                current=$("$CTL" service-get "$service.enabled" 2>/dev/null || echo false)
                [ "$current" = true ] && value=false || value=true
                "$CTL" service-set "$service.enabled" "$value"; pause; continue ;;
            5)
