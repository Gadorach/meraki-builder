list_users() {
    printf '%-20s %-10s %s\n' USER ROLE SHELL
    printf '%-20s %-10s %s\n' '--------------------' '----------' '--------------------'
    while IFS=: read -r user _ uid _ _ home shell; do
        [ "$uid" = 0 ] || [ "$uid" -ge 1000 ] 2>/dev/null || continue
        role=none
        [ "$user" = root ] && role=admin
        grep -q "^postmerkos-admin:.*\(^\|,\)$user\(,\|$\)" /etc/group 2>/dev/null && role=admin
        [ "$role" = none ] && grep -q "^postmerkos-operator:.*\(^\|,\)$user\(,\|$\)" /etc/group 2>/dev/null && role=operator
        [ "$role" = none ] && grep -q "^postmerkos-viewer:.*\(^\|,\)$user\(,\|$\)" /etc/group 2>/dev/null && role=viewer
        printf '%-20s %-10s %s\n' "$user" "$role" "$shell"
    done </etc/passwd
}

