config BR2_PACKAGE_POSTMERKOS_HARDWARE
	bool "postmerkOS hardware policy helpers"
	default y
	select BR2_PACKAGE_CONFIGD
	select BR2_PACKAGE_FWUPDATE
	help
	  Capability-v2 hardware discovery, LED ownership and one-shot PoE
	  boot-prune policy. Reset discovery is read-only until a model-specific
	  input is hardware verified; destructive reset remains disabled.
