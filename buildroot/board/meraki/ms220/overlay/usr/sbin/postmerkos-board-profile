#!/bin/sh
# Canonical exact-model runtime profile for supported VCore-III Meraki switches.
set -eu
model=${1:-}
[ -n "$model" ] || { echo 'usage: postmerkos-board-profile MODEL' >&2; exit 2; }
MODULE_FAMILY= BOARD_DESCRIPTOR= LOGICAL_PORTS= COPPER_PORTS=
POE_CAPABLE=0 POE_LED_ALLOWED=0 POE_GPIO_VERIFIED=0 POE_GPIO_A= POE_GPIO_B=
RESET_DESTRUCTIVE_ENABLED=0
case "$model" in
  MS220-8) MODULE_FAMILY=luton26; BOARD_DESCRIPTOR=MERAKI_BOARD_MS220_8; LOGICAL_PORTS=10; COPPER_PORTS=8; POE_LED_ALLOWED=1 ;;
  MS220-8P) MODULE_FAMILY=luton26; BOARD_DESCRIPTOR=MERAKI_BOARD_MS220_8; LOGICAL_PORTS=10; COPPER_PORTS=8; POE_CAPABLE=1; POE_LED_ALLOWED=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=7; POE_GPIO_B=12 ;;
  MS220-24) MODULE_FAMILY=luton26; BOARD_DESCRIPTOR=MERAKI_BOARD_MS220_24; LOGICAL_PORTS=26; COPPER_PORTS=24 ;;
  MS220-24P) MODULE_FAMILY=luton26; BOARD_DESCRIPTOR=MERAKI_BOARD_MS220_24; LOGICAL_PORTS=26; COPPER_PORTS=24; POE_CAPABLE=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=82; POE_GPIO_B=81 ;;
  MS22) MODULE_FAMILY=luton26; BOARD_DESCRIPTOR=MERAKI_BOARD_MS22; LOGICAL_PORTS=26; COPPER_PORTS=24 ;;
  MS22P) MODULE_FAMILY=luton26; BOARD_DESCRIPTOR=MERAKI_BOARD_MS22; LOGICAL_PORTS=26; COPPER_PORTS=24; POE_CAPABLE=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=82; POE_GPIO_B=81 ;;
  MS320-24) MODULE_FAMILY=jaguar; BOARD_DESCRIPTOR=MERAKI_BOARD_MS320_24; LOGICAL_PORTS=28; COPPER_PORTS=24 ;;
  MS320-24P) MODULE_FAMILY=jaguar; BOARD_DESCRIPTOR=MERAKI_BOARD_MS320_24; LOGICAL_PORTS=28; COPPER_PORTS=24; POE_CAPABLE=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=9; POE_GPIO_B=8 ;;
  MS220-48) MODULE_FAMILY=jaguar_dual; BOARD_DESCRIPTOR=MERAKI_BOARD_MS220_48; LOGICAL_PORTS=52; COPPER_PORTS=48 ;;
  MS220-48P|MS220-48LP|MS220-48FP) MODULE_FAMILY=jaguar_dual; BOARD_DESCRIPTOR=MERAKI_BOARD_MS220_48; LOGICAL_PORTS=52; COPPER_PORTS=48; POE_CAPABLE=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=41; POE_GPIO_B=40 ;;
  MS320-48) MODULE_FAMILY=jaguar_dual; BOARD_DESCRIPTOR=MERAKI_BOARD_MS320_48; LOGICAL_PORTS=52; COPPER_PORTS=48 ;;
  MS320-48P|MS320-48LP|MS320-48FP) MODULE_FAMILY=jaguar_dual; BOARD_DESCRIPTOR=MERAKI_BOARD_MS320_48; LOGICAL_PORTS=52; COPPER_PORTS=48; POE_CAPABLE=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=41; POE_GPIO_B=40 ;;
  MS42) MODULE_FAMILY=jaguar_dual; BOARD_DESCRIPTOR=MERAKI_BOARD_MS42; LOGICAL_PORTS=52; COPPER_PORTS=48 ;;
  MS42P) MODULE_FAMILY=jaguar_dual; BOARD_DESCRIPTOR=MERAKI_BOARD_MS42; LOGICAL_PORTS=52; COPPER_PORTS=48; POE_CAPABLE=1; POE_GPIO_VERIFIED=1; POE_GPIO_A=41; POE_GPIO_B=8 ;;
  *) echo "unsupported model: $model" >&2; exit 1 ;;
esac
cat <<PROFILE
MODEL=$model
MODULE_FAMILY=$MODULE_FAMILY
BOARD_DESCRIPTOR=$BOARD_DESCRIPTOR
LOGICAL_PORTS=$LOGICAL_PORTS
COPPER_PORTS=$COPPER_PORTS
POE_CAPABLE=$POE_CAPABLE
POE_LED_ALLOWED=$POE_LED_ALLOWED
POE_GPIO_VERIFIED=$POE_GPIO_VERIFIED
POE_GPIO_A=$POE_GPIO_A
POE_GPIO_B=$POE_GPIO_B
RESET_DESTRUCTIVE_ENABLED=$RESET_DESTRUCTIVE_ENABLED
PROFILE
