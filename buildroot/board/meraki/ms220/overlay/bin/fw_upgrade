#!/bin/sh
# Command alias that delegates validation and flash writes to the transactional updater.
set -u

usage() {
    cat <<'USAGE'
usage: fw_upgrade [-v] [-f] FIRMWARE

Compatibility wrapper around fw_update:
  -v  validate only; do not write flash
  -f  permit recovery/development metadata exceptions

Kernel-only (-k) direct-MTD flashing is unsupported. Use a complete 16 MiB
image with `fw_update --full-flash` when intentionally replacing the loader or
kernel.
USAGE
}

verify_only=0
force=0
while getopts 'hvfk' option; do
    case "$option" in
        h) usage; exit 0 ;;
        v) verify_only=1 ;;
        f) force=1 ;;
        k)
            echo 'fw_upgrade: kernel-only direct-MTD flashing is unsupported' >&2
            echo 'Use fw_update --full-flash with an exact 16 MiB image.' >&2
            exit 2
            ;;
        *) usage >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ "${1:-}" = -- ] && shift
[ "$#" -eq 1 ] || { usage >&2; exit 2; }

set -- "$1" --overlay preserve
[ "$verify_only" -eq 0 ] || set -- "$@" --verify-only
[ "$force" -eq 0 ] || set -- "$@" --force
exec /bin/fw_update "$@"
