#!/bin/sh
#
# Change the password from 'postmerkOS' to the device serial
#

start() {
    # Retire the legacy default-password marker: default detection is now a
    # deterministic serial-hash check in configd, so this stale flag (which older
    # firmware left on the persistent /config overlay) is no longer read.
    rm -f /config/postmerkos/default-password-active
    # determine if we have the default password
    password_salt=$(echo "postmerkOS" | mkpasswd -S __SALT__ -m sha256)
    # set a device specific password
    if [ $(grep -c $password_salt /etc/shadow) -eq 1 ]; then
        serial=$(board_data serial) 
        if [ -n "$serial" ]; then
            echo -e "${serial}\n${serial}" | passwd -a sha256 root >/dev/null 2>&1
            echo "Set root password to device serial number"
        fi
    fi
}

stop() {
    /bin/true
}

restart() {
    stop
    start
}

case "$1" in
  start)
      start
    ;;
  stop)
      stop
    ;;
  restart|reload)
      restart
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit $?
