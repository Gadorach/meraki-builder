#!/bin/sh
STATE=/config/postmerkos
DEFAULTS=/usr/share/postmerkos/defaults

start() {
    mkdir -p "$STATE" "$STATE/update-history"
    chmod 0700 "$STATE" "$STATE/update-history"
    for name in services security time firmware-repositories; do
        [ -s "$STATE/$name.json" ] || cp "$DEFAULTS/$name.json" "$STATE/$name.json"
        chmod 0600 "$STATE/$name.json"
    done
    for group in postmerkos-admin postmerkos-operator postmerkos-viewer; do
        grep -q "^$group:" /etc/group 2>/dev/null || addgroup "$group" >/dev/null 2>&1 || true
    done
    # Root's home is an overlayfs upper on JFFS2. If its first writer is the
    # unprivileged (uid 1000) build/runtime user, /root ends up owned by that uid
    # and dropbear's StrictModes silently rejects ~/.ssh/authorized_keys, forcing
    # password auth. Assert root ownership/permissions here (S04 runs before
    # configd at S15), so the upper is created/owned by root. Idempotent and
    # self-healing across reflashes and overlay resets; configd runs as root so
    # it can still manage authorized_keys under 0700.
    mkdir -p /root/.ssh
    chown root:root /root /root/.ssh
    chmod 0700 /root /root/.ssh
    if [ -f /root/.ssh/authorized_keys ]; then
        chown root:root /root/.ssh/authorized_keys
        chmod 0600 /root/.ssh/authorized_keys
    fi
}

case "$1" in
    start) start ;;
    stop) : ;;
    restart|reload) start ;;
    *) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
