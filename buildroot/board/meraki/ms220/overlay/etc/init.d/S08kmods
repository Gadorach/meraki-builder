#!/bin/sh
# Load the platform-selected Vitesse/Click module stack.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
BOARDINFO=${POSTMERKOS_BOARDINFO:-/run/postmerkos/boardinfo}
CPUINFO=${POSTMERKOS_CPUINFO:-/proc/cpuinfo}
NUM_PORTS_FILE=${POSTMERKOS_NUM_PORTS_FILE:-/tmp/NUM_PORTS}
PROFILE_FILE=${POSTMERKOS_MODULE_PROFILE:-/run/postmerkos/module-profile}
PROFILE_HELPER=${POSTMERKOS_BOARD_PROFILE:-/usr/sbin/postmerkos-board-profile}
EMBEDDED_MODULE_ROOT=${POSTMERKOS_MODULE_ROOT:-/lib/modules}

log() { echo "postmerkOS modules: $*"; }
fail() { log "ERROR: $*" >&2; return 1; }

read_model() {
    model=
    if [ -r "$BOARDINFO" ]; then
        model=$(sed -n 's/^MODEL=//p' "$BOARDINFO" | sed -n '1p' | tr -cd 'A-Za-z0-9_-')
    fi
    if [ -z "$model" ] && command -v board_data >/dev/null 2>&1; then
        model=$(board_data model 2>/dev/null || true)
    fi
    if [ -z "$model" ] && [ -r "$CPUINFO" ]; then
        cpu=$(sed -n 's/^[[:space:]]*system type[[:space:]]*:[[:space:]]*//p' "$CPUINFO" | sed -n '1p')
        case "$cpu" in
            *VSC7425*) model=MS220-8 ;;
            *VSC7427*) model=MS220-24 ;;
            *"VSC7434 Dual"*) model=MS220-48 ;;
            *VSC7434*) model=MS320-24 ;;
        esac
    fi
    [ -n "$model" ] || return 1
    printf '%s\n' "$model"
}

determine_board() {
    model=$(read_model) || { fail 'could not identify a supported platform'; return 1; }
    profile=$($PROFILE_HELPER "$model" 2>/dev/null) || {
        fail "unsupported or unidentified model '$model'"; return 1;
    }
    eval "$profile"
    mkdir -p "$(dirname "$NUM_PORTS_FILE")" "$(dirname "$PROFILE_FILE")"
    printf '%s\n' "$LOGICAL_PORTS" > "$NUM_PORTS_FILE.tmp.$$" || return 1
    mv -f "$NUM_PORTS_FILE.tmp.$$" "$NUM_PORTS_FILE" || return 1
    {
        printf '%s\n' "$profile"
        printf 'DETECTION_SOURCE=%s\n' "$([ -r "$BOARDINFO" ] && echo exact-runtime || echo family-fallback)"
    } > "$PROFILE_FILE.tmp.$$" || return 1
    chmod 0444 "$PROFILE_FILE.tmp.$$" 2>/dev/null || true
    mv -f "$PROFILE_FILE.tmp.$$" "$PROFILE_FILE" || return 1
    export model MODULE_FAMILY BOARD_DESCRIPTOR LOGICAL_PORTS COPPER_PORTS
    log "detected $model; selecting $MODULE_FAMILY ($BOARD_DESCRIPTOR), $LOGICAL_PORTS logical ports"
}

selected_modules() {
    printf '%s\n' \
        "$MODULE_FAMILY/vtss_core.ko" \
        proclikefs.ko \
        merakiclick.ko \
        elts_meraki.ko \
        "$MODULE_FAMILY/vc_click.ko"
}

verify_hash_entry() {
    root=$1 relative=$2 manifest="$1/postmerkos-modules.sha256"
    [ -r "$manifest" ] || return 0
    expected=$(awk -v f="$relative" '$2 == f || $2 == "./" f {print $1; exit}' "$manifest")
    [ -n "$expected" ] || { fail "module hash entry is missing: $relative"; return 1; }
    actual=$(sha256sum "$root/$relative" 2>/dev/null | awk '{print $1}')
    [ "$actual" = "$expected" ] || { fail "module hash mismatch: $relative"; return 1; }
}

verify_vermagic() {
    path=$1
    running=$(uname -r)
    vermagic=$(strings "$path" 2>/dev/null | sed -n 's/^vermagic=\([^ ]*\).*/\1/p' | sed -n '1p')
    [ -n "$vermagic" ] || { fail "module has no vermagic: ${path##*/}"; return 1; }
    [ "$vermagic" = "$running" ] || {
        fail "module ${path##*/} targets $vermagic but the running kernel is $running"; return 1;
    }
}

verify_selected_modules() {
    root=$1
    for relative in $(selected_modules); do
        path="$root/$relative"
        [ -f "$path" ] && [ ! -L "$path" ] && [ -s "$path" ] || {
            fail "missing module $relative"; return 1;
        }
        verify_hash_entry "$root" "$relative" || return 1
        verify_vermagic "$path" || return 1
    done
}

loaded_now=
load_one() {
    module_name=$1 path=$2
    shift 2
    if grep -q "^${module_name} " /proc/modules 2>/dev/null; then
        log "$module_name already loaded"
        return 0
    fi
    if insmod "$path" "$@"; then
        loaded_now="$module_name $loaded_now"
        log "loaded ${path#$MOD_PATH/}"
        return 0
    fi
    fail "failed to load ${path#$MOD_PATH/}"
}

unwind_new_modules() {
    for module_name in $loaded_now; do
        rmmod "$module_name" 2>/dev/null || true
    done
}

load_modules() {
    verify_selected_modules "$MOD_PATH" || return 1
    load_one vtss_core "$MOD_PATH/$MODULE_FAMILY/vtss_core.ko" "board_desc=$BOARD_DESCRIPTOR" || { unwind_new_modules; return 1; }
    load_one proclikefs "$MOD_PATH/proclikefs.ko" || { unwind_new_modules; return 1; }
    load_one merakiclick "$MOD_PATH/merakiclick.ko" || { unwind_new_modules; return 1; }
    load_one elts_meraki "$MOD_PATH/elts_meraki.ko" || { unwind_new_modules; return 1; }
    load_one vc_click "$MOD_PATH/$MODULE_FAMILY/vc_click.ko" || { unwind_new_modules; return 1; }
    return 0
}

largest_blocksize() {
    offset=$1 block=1 power=2
    while [ "$power" -le 64 ]; do
        [ $((offset % power)) -eq 0 ] || break
        block=$power; power=$((power * 2))
    done
    echo "$block"
}

recover_modules() {
    command -v find_hdr >/dev/null 2>&1 || { fail 'embedded modules are incomplete and find_hdr is unavailable'; return 1; }
    stage=/tmp/postmerkos-module-recovery.$$
    rm -rf "$stage"; mkdir -p "$stage" || return 1
    for part in part1 part2; do
        number=$(awk -F: -v n="\"$part\"" '$4 == n {gsub(/^mtd/,"",$1); print $1; exit}' /proc/mtd 2>/dev/null)
        [ -n "$number" ] || continue
        device=/dev/mtdblock$number
        offset=$(find_hdr -g "$device" 2>/dev/null || echo -1)
        case "$offset" in -1|''|*[!0-9]*) continue ;; esac
        block=$(largest_blocksize "$offset")
        log "recovering $MODULE_FAMILY modules from $part"
        (
            cd "$stage" || exit 1
            dd if="$device" bs="$block" skip=$((offset / block)) 2>/dev/null |
                gzip -dc 2>/dev/null |
                cpio -idmu 'lib/modules/*.ko' "lib/modules/$MODULE_FAMILY/*.ko" 2>/dev/null
        ) || true
        if [ -d "$stage/lib/modules" ]; then
            MOD_PATH=$stage/lib/modules
            if verify_selected_modules "$MOD_PATH"; then
                load_modules
                rc=$?
                rm -rf "$stage"
                return "$rc"
            fi
        fi
        rm -rf "$stage"; mkdir -p "$stage"
    done
    rm -rf "$stage"
    fail "could not recover compatible $MODULE_FAMILY modules"
}

start() {
    determine_board || return 1
    if grep -q '^vc_click ' /proc/modules 2>/dev/null; then
        log 'switch module stack is already active'
        return 0
    fi
    MOD_PATH=$EMBEDDED_MODULE_ROOT
    if verify_selected_modules "$MOD_PATH"; then
        load_modules
    else
        recover_modules
    fi
}

stop() {
    # The Vitesse stack owns the live ASIC. Forced unload is unsafe and normal
    # service shutdown is immediately followed by reboot/poweroff.
    log 'retaining active switch module stack until reboot'
    return 0
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart|reload) start ;;
  profile)
    determine_board || exit 1
    cat "$PROFILE_FILE"
    ;;
  *) echo "Usage: $0 {start|stop|restart|reload|profile}" >&2; exit 2 ;;
esac
