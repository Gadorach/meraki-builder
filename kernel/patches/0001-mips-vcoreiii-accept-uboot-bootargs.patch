 	  Normally, you will choose 'N' here.
 
+config CMDLINE_FALLBACK
+	bool "Use built-in command line only when firmware provides none"
+	default n
+	depends on CMDLINE_BOOL && !CMDLINE_OVERRIDE
+	help
+	  Select this when the platform must retain a built-in command line for
+	  legacy bootloaders, but should prefer a valid command line supplied by
+	  firmware or a second-stage bootloader.  Unlike the normal append mode,
+	  the built-in string is not concatenated after firmware arguments, so
+	  fallback root= and mem= settings cannot override U-Boot parameters.
+
+	  This is useful while migrating a system from a legacy loader to U-Boot.
+
 config SB1XXX_CORELIS
 	bool "Corelis Debugger"
 	depends on SIBYTE_SB1xxx_SOC
