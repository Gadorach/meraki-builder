@@ -76,22 +78,171 @@
 }
 
 #if !defined(CONFIG_CMDLINE_OVERRIDE)
-static void __init prom_init_cmdline(void)                           
-{                                                                    
-        int argc = fw_arg0;                                          
-        char **argv = (char **) KSEG0ADDR(fw_arg1);                  
-        int i;                                                       
-                                                                     
-        arcs_cmdline[0] = '\0';                                      
-                                                                     
-        for (i = 0; i < argc; i++) {                                 
-                char *p = (char *) KSEG0ADDR(argv[i]);               
-                                                                     
-                if (CPHYSADDR(p) && *p) {                            
-                        strlcat(arcs_cmdline, p, sizeof(arcs_cmdline));
-                        strlcat(arcs_cmdline, " ", sizeof(arcs_cmdline));
-                }                                                        
-        }                                                                
+#define VCOREIII_PROM_RAM_BYTES       (128UL * 1024UL * 1024UL)
+#define VCOREIII_PROM_MAX_ARGS       64
+#define VCOREIII_PROM_MAX_ENVS       64
+#define VCOREIII_PROM_MAX_STRING     512
+
+static unsigned int __initdata prom_argc_accepted;
+static unsigned int __initdata prom_envc_accepted;
+static bool __initdata prom_firmware_cmdline;
+
+static bool __init prom_range_valid(unsigned long address, unsigned long bytes,
+                                    unsigned long alignment)
+{
+        unsigned long phys;
+
+        if (KSEGX(address) != KSEG0 && KSEGX(address) != KSEG1)
+                return false;
+        phys = CPHYSADDR(address);
+        if (!phys || phys >= VCOREIII_PROM_RAM_BYTES)
+                return false;
+        if (alignment && (phys & (alignment - 1)))
+                return false;
+        if (bytes > VCOREIII_PROM_RAM_BYTES - phys)
+                return false;
+        return true;
+}
+
+static const char *__init prom_string(unsigned long address)
+{
+        const char *value;
+
+        if (!prom_range_valid(address, VCOREIII_PROM_MAX_STRING, 1))
+                return NULL;
+        value = (const char *)KSEG0ADDR(address);
+        if (strnlen(value, VCOREIII_PROM_MAX_STRING) == VCOREIII_PROM_MAX_STRING)
+                return NULL;
+        return value;
+}
+
+static bool __init prom_cmdline_has(const char *name)
+{
+        const char *p = arcs_cmdline;
+        size_t length = strlen(name);
+
+        while (*p) {
+                while (*p == ' ')
+                        p++;
+                if (!strncmp(p, name, length) && p[length] == '=')
+                        return true;
+                while (*p && *p != ' ')
+                        p++;
+        }
+        return false;
+}
+
+static bool __init prom_append_argument(const char *argument)
+{
+        size_t old_length = strlen(arcs_cmdline);
+        size_t arg_length = strlen(argument);
+
+        if (!arg_length)
+                return false;
+        if (old_length && old_length + 1 >= COMMAND_LINE_SIZE)
+                return false;
+        if (old_length)
+                strlcat(arcs_cmdline, " ", COMMAND_LINE_SIZE);
+        strlcat(arcs_cmdline, argument, COMMAND_LINE_SIZE);
+        return strlen(arcs_cmdline) > old_length;
+}
+
+static const char *__init prom_find_environment(const char *name)
+{
+        unsigned long *envp;
+        unsigned long envp_address = fw_arg2;
+        size_t name_length = strlen(name);
+        unsigned int i;
+
+        if (!prom_range_valid(envp_address,
+                              VCOREIII_PROM_MAX_ENVS * sizeof(*envp),
+                              sizeof(*envp)))
+                return NULL;
+        envp = (unsigned long *)KSEG0ADDR(envp_address);
+
+        for (i = 0; i < VCOREIII_PROM_MAX_ENVS; i++) {
+                const char *entry;
+                unsigned long entry_address = envp[i];
+
+                if (!entry_address)
+                        break;
+                entry = prom_string(entry_address);
+                if (!entry)
+                        break;
+                prom_envc_accepted = i + 1;
+                if (!strncmp(entry, name, name_length) &&
+                    entry[name_length] == '=')
+                        return entry + name_length + 1;
+        }
+        return NULL;
+}
+
+static void __init prom_import_environment(void)
+{
+        const char *memsize;
+        const char *initrd_address;
+        const char *initrd_size;
+        char argument[48];
+        unsigned long value;
+
+        memsize = prom_find_environment("memsize");
+        if (memsize && !prom_cmdline_has("mem")) {
+                value = simple_strtoul(memsize, NULL, 0);
+                if (value) {
+                        if (value > 4096)
+                                snprintf(argument, sizeof(argument), "mem=%lu", value);
+                        else
+                                snprintf(argument, sizeof(argument), "mem=%luM", value);
+                        prom_append_argument(argument);
+                }
+        }
+
+        initrd_address = prom_find_environment("initrd_start");
+        initrd_size = prom_find_environment("initrd_size");
+        if (initrd_address && initrd_size &&
+            !prom_cmdline_has("rd_start") && !prom_cmdline_has("rd_size")) {
+                unsigned long start = simple_strtoul(initrd_address, NULL, 0);
+                unsigned long size = simple_strtoul(initrd_size, NULL, 0);
+
+                if (start && size) {
+                        snprintf(argument, sizeof(argument), "rd_start=0x%08lx",
+                                 (unsigned long)KSEG0ADDR(start));
+                        prom_append_argument(argument);
+                        snprintf(argument, sizeof(argument), "rd_size=0x%lx", size);
+                        prom_append_argument(argument);
+                }
+        }
+}
+
+static void __init prom_init_cmdline(void)
+{
+        unsigned long *argv;
+        unsigned long argv_address = fw_arg1;
+        unsigned int argc = fw_arg0;
+        unsigned int i;
+
+        arcs_cmdline[0] = '\0';
+
+        if (!argc || argc > VCOREIII_PROM_MAX_ARGS)
+                return;
+        if (!prom_range_valid(argv_address, argc * sizeof(*argv), sizeof(*argv)))
+                return;
+        argv = (unsigned long *)KSEG0ADDR(argv_address);
+
+        for (i = 0; i < argc; i++) {
+                const char *argument;
+
+                if (!argv[i])
+                        continue;
+                argument = prom_string(argv[i]);
+                if (!argument)
+                        break;
+                if (prom_append_argument(argument))
+                        prom_argc_accepted++;
+        }
+
+        prom_import_environment();
+        prom_firmware_cmdline = arcs_cmdline[0] != '\0';
 }
 #endif
 
